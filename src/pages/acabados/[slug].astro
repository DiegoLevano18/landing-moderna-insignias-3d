---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../config';

export async function getStaticPaths() {
  return (await getCollection('acabados')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(url('/'), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Acabados', item: new URL(url('/acabados/'), Astro.site).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title },
  ],
};
---
<Base title={`${entry.data.title}: insignias personalizadas | MARQA`} description={entry.data.resumen} schema={[crumbs]}>
  <article class="page">
    <header class="page-head">
      <p class="crumbs"><a href={url('/')}>Inicio</a> / <a href={url('/acabados/')}>Acabados</a></p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.resumen}</p>
    </header>
    <div class="split">
      <div class="prose"><Content /></div>
      <aside class="prose">
        <div class:list={['swatch', `tx-${entry.data.textura}`]}><i></i></div>
        <h2>Ideal para</h2>
        <ul class="chips">{entry.data.ideal.map((i) => <li>{i}</li>)}</ul>
        <p><a class="btn" href={url('/#cotizar')}>Cotizar este acabado</a></p>
      </aside>
    </div>
  </article>
</Base>
